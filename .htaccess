# Redirections 301 des anciennes URLs .html vers les URLs propres
# (voir commit 51f8c4e — restructuration en dossier + index.html)
<IfModule mod_alias.c>
  Redirect 301 /index.html /
  Redirect 301 /apropos.html /apropos/
  Redirect 301 /projets.html /projets/
  Redirect 301 /services.html /services/
  Redirect 301 /contact.html /contact/
  Redirect 301 /mentions-legales.html /mentions-legales/
  Redirect 301 /projets/guilbaud.html /projets/guilbaud/
  Redirect 301 /projets/msy.html /projets/msy/
  Redirect 301 /projets/octy.html /projets/octy/
</IfModule>
